# ==============================================================================
# Telegram Gateway Configuration
# ==============================================================================

# Telegram Bot Token dari @BotFather (Wajib)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Hard security invariant: hanya Telegram user ID ini yang diizinkan memakai Xiao.
# User ID non-owner akan diabaikan secara senyap (100% dropped).
# Dapat dikonfigurasi via: xiao gateway owner <ID> atau xiao setup
OWNER_USER_ID=123456789

# Opsional: ID grup tambahan tempat OWNER_USER_ID boleh memakai bot.
# Di grup ini Xiao hanya merespons jika dimention (@bot_username) atau direply.
# Pisahkan beberapa ID dengan koma (misal: -1001234567890,-1009876543210). Kosongkan untuk private chat saja.
ALLOWED_CHAT_IDS=

# Opsional: ID grup forum supergroup yang dijadikan Dedicated Personal Workspace.
# Di grup ini Xiao menjawab semua pesan owner di semua topik tanpa perlu mention/reply/slash.
# Kosongkan secara default; tambahkan ID grup forum (misal: -1001234567890).
DEDICATED_CHAT_IDS=


# ==============================================================================
# OpenAI-Compatible AI Provider
# ==============================================================================

# URL endpoint API yang kompatibel dengan OpenAI (/v1)
AI_ENDPOINT=http://127.0.0.1:8317/v1

# Kunci API untuk otentikasi provider AI
AI_API_KEY=xiao

# Model utama yang digunakan untuk percakapan
AI_MODEL=gemini-3.7-flash-high


# ==============================================================================
# Image Generation & Fallback Settings
# ==============================================================================

# Provider fallback image eksternal jika endpoint OpenAI images gagal/tidak didukung.
# Nilai: "none" (default aman) atau "pollinations" (opt-in untuk prompt gambar publik).
IMAGE_FALLBACK_PROVIDER=none


# ==============================================================================
# Network Timeouts (Detik)
# ==============================================================================

# Connect timeout umum untuk chat completions, capability probe, dan STT
AI_PROVIDER_CONNECT_TIMEOUT_SECS=10

# Connect timeout untuk unduhan payload image
IMAGE_PROVIDER_CONNECT_TIMEOUT_SECS=10

# Timeout proses pembuatan gambar (image generation)
IMAGE_GENERATION_TIMEOUT_SECS=120

# Timeout pengunduhan hasil gambar yang digenerate
IMAGE_DOWNLOAD_TIMEOUT_SECS=30


# ==============================================================================
# Web Search & Tool Calling (Opsional)
# Prioritas pencarian: Brave -> Tavily -> Exa API -> Exa MCP (Keyless) -> DuckDuckGo
# ==============================================================================

# API key untuk Brave Search API
BRAVE_API_KEY=

# API key untuk Tavily AI Search API (dapat juga menggunakan TAVILY_KEY)
TAVILY_API_KEY=

# API key untuk Exa AI REST API (dapat juga menggunakan EXA_KEY)
EXA_API_KEY=

# URL endpoint Exa MCP untuk mode keyless (default: https://mcp.exa.ai/)
EXA_MCP_URL=https://mcp.exa.ai/


# ==============================================================================
# Logging & Debugging (Opsional)
# ==============================================================================

# Filter level log aplikasi (misal: info, debug, warn, xiao=debug)
RUST_LOG=info
