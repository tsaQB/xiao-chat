# Telegram Bot Token dari @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Hard security invariant: hanya Telegram user ID ini yang boleh memakai XiaoAI.
# Dapat diatur lewat: xiao gateway atau xiao setup
OWNER_USER_ID=123456789

# Opsional: chat/group tambahan tempat OWNER_USER_ID boleh memakai bot.
# Pisahkan beberapa chat ID dengan koma. Kosongkan untuk private chat owner saja.
ALLOWED_CHAT_IDS=

# Opsional: grup forum/topik tambahan yang dijadikan Dedicated Personal Workspace
# Di grup ini Xiao menjawab semua pesan owner di seluruh topik tanpa perlu mention/reply/slash.
# Kosong secara default; harus diatur manual jika ingin menambahkan ruang kerja (misal: -1001234567890, pisahkan koma).
DEDICATED_CHAT_IDS=

# Konfigurasi endpoint AI OpenAI-compatible
AI_ENDPOINT=http://127.0.0.1:8317/v1
AI_API_KEY=xiao
AI_MODEL=gemini-3.7-flash-high

# Fallback image eksternal bersifat opt-in. Nilai aman default: none
# Set ke pollinations hanya jika Anda menyetujui prompt gambar dikirim ke layanan tersebut.
IMAGE_FALLBACK_PROVIDER=none

# Connect timeout umum untuk chat, probe, STT, dan traffic provider AI.
AI_PROVIDER_CONNECT_TIMEOUT_SECS=10

# Batas khusus image. Timeout tidak berarti capability Unsupported.
# IMAGE_PROVIDER_CONNECT_TIMEOUT_SECS hanya untuk koneksi download image (legacy-compatible).
IMAGE_PROVIDER_CONNECT_TIMEOUT_SECS=10
IMAGE_GENERATION_TIMEOUT_SECS=120
IMAGE_DOWNLOAD_TIMEOUT_SECS=30
